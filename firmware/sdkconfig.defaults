# TinyBar firmware defaults (ESP-IDF v5.4.2, ESP32-S3R8 on the Waveshare ESP32-S3-Touch-LCD-3.49 V2).
# Owned by the lead developer. Builders: describe a change in your report rather than editing this file.

# ---------- Chip, flash, PSRAM ----------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# Octal PSRAM at 80 MHz, as in Waveshare's V2 examples. malloc() above 4 KB goes to PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Task stacks that never touch flash may live in PSRAM (httpd, usb_rx, dns: see ARCHITECTURE.md section 11), and so
# may the core model (g_app, EXT_RAM_BSS_ATTR): internal RAM is the scarce one.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Boot time: SYS_EN (the power hold) goes high in app_main, so everything before it delays it. The full 8 MB PSRAM
# test takes about 0.5 to 0.8 s, and the bootloader's INFO log adds more; on battery a short PWR press would not
# keep the bar on. Both off.
CONFIG_SPIRAM_MEMTEST=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The default event loop runs net's Wi-Fi handlers (on_wifi alone is a 1 KB frame) plus the protocol-safe logger.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=5120

# ---------- Console: USB Serial/JTAG only ----------
# The board's USB-C is the ESP32-S3's USB Serial/JTAG port (VID 0x303A, PID 0x1001). It carries the log and the
# Mac app's "@tb " protocol lines (api.md section 6). net installs the driver and owns the writer.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_COLORS=n

# ---------- Robustness ----------
# Task watchdog: the app task (LVGL + core) and the network tasks subscribe; a freeze restarts the bar.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# OTA: two slots and rollback, so a later update that fails to start goes back to the previous image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Power off on USB is a deep sleep woken by PWR: don't re-check the whole image on every wake (it was checked at boot).
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y

# ---------- Wi-Fi ----------
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# "Work login" networks: WPA2-Enterprise (PEAP with MSCHAPv2; TTLS too).
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y
CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_LWIP_LOCAL_HOSTNAME="tinybar"
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_DHCPS=y
# The setup network's DHCP names the bar as the DNS server, so the catch-all DNS (net_dns.c) answers every name.
# net_wifi.c sets that explicitly (ESP_NETIF_DOMAIN_NAME_SERVER and the DNS address); this default-on option, which
# offers the server's own address when none is set, stays as a second line until IDF v6 removes it.
CONFIG_LWIP_DHCPS_ADD_DNS=y
# Time: an office's own NTP server from DHCP first (offices often block public NTP), then pool.ntp.org and
# time.google.com (net_wifi.c sntp_start puts DHCP's at index 0 and the two names at 1 and 2).
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_IPV6=y
CONFIG_MDNS_MAX_SERVICES=4
# Wi-Fi and the network stack stay on core 0, the screen on core 1 (ARCHITECTURE.md section 3). The tcpip thread
# runs DHCP-server callbacks that log, so it gets 4 KB.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# ---------- I2C (system bus: expander, IMU, RTC, touch, codec) ----------
# NVS writes disable the cache for tens to hundreds of ms; an IRAM-safe ISR lets a transaction that straddles one
# finish instead of timing out (every I2C caller's buffers are on internal stacks).
CONFIG_I2C_ISR_IRAM_SAFE=y

# ---------- HTTP server (api.md 2.5 and section 15) ----------
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=n
CONFIG_HTTPD_PURGE_BUF_LEN=128

# ---------- TLS (calendar fetch) ----------
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# TLS buffers in PSRAM, sized per record, so a fetch doesn't take 40 KB of internal RAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# ---------- NVS ----------
# Encryption of the nvs_sec partition (calendar address, token hashes) needs an HMAC key burned into eFuse, which
# can't be undone. Off until the user agrees; see ARCHITECTURE.md, "Secrets".
CONFIG_NVS_ENCRYPTION=n

# ---------- LVGL 9.5 ----------
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL runs only in the app task (see ARCHITECTURE.md), so it needs no OS locking of its own.
CONFIG_LV_OS_NONE=y
# LVGL's allocations (objects, label text, layers) go to PSRAM through board/src/board_lv_mem.c, so they don't press
# on internal RAM (with plain malloc() everything under 4 KB stayed internal). LVGL only runs on the app task, never
# while the cache is off.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
# LVGL's hot paths stay in flash (cached). Putting them in IRAM (LV_ATTRIBUTE_FAST_MEM_USE_IRAM) takes 107 KB of
# internal RAM, which left about 70 KB for Wi-Fi, TLS, task stacks and the display's DMA buffer. The bar redraws a
# few times a second at most; measure the frame time on the board before reconsidering.
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n
CONFIG_LV_USE_DRAW_SW=y
CONFIG_LV_DRAW_SW_COMPLEX=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
# Fonts made with lv_font_conv: big sizes need the large format; compression is lv_font_conv's default.
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_LABEL_LONG_TXT_HINT=y
CONFIG_LV_USE_IMAGE=y
CONFIG_LV_USE_CANVAS=y
# The Wi-Fi setup screen's QR code (WIFI:T:nopass;S:TinyBar-Setup;;).
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_SNAPSHOT=n
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
